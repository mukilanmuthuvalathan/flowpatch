# GEMINI_API_KEY: Optional for AI Studio server-side Gemini calls.
# FlowPatch works 100% locally out of the box using the deterministic Local Demo Agent.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# OPTIONAL KANE CLI / TESTMU AI CLOUD CREDENTIALS:
# If set (or if you run `kane-cli login`), `kane-cli testmd run` authenticates with TestMu AI Cloud.
# If omitted, FlowPatch shows the real kane-cli diagnostic and automatically executes the
# 4 steps of flows/task_board_flow_test.md in local headless Chromium.
LT_USERNAME=""
LT_ACCESS_KEY=""
